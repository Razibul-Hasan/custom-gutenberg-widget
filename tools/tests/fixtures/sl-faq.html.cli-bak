tem is-layout-flow wp-block-details-is-layout-flow"><summary><span class="bwex-faq__n" aria-hidden="true">04</span><span class="bwex-faq__q">WordPress or Shopify?</span><span class="bwex-faq__icon" aria-hidden="true"></span></summary><div class="wp-block-group bwex-faq__a is-layout-flow wp-block-group-is-layout-flow"><p class="wp-block-paragraph">We do both.</p></div></details><details class="wp-block-details bwex-faq__item is-layout-flow wp-block-details-is-layout-flow"><summary><span class="bwex-faq__n" aria-hidden="true">05</span><span class="bwex-faq__q">Can you migrate?</span><span class="bwex-faq__icon" aria-hidden="true"></span></summary><div class="wp-block-group bwex-faq__a is-layout-flow wp-block-group-is-layout-flow"><p class="wp-block-paragraph">Yes, with 301s.</p></div></details><details class="wp-block-details bwex-faq__item is-layout-flow wp-block-details-is-layout-flow"><summary><span class="bwex-faq__n" aria-hidden="true">06</span><span class="bwex-faq__q">Support after launch?</span><span class="bwex-faq__icon" aria-hidden="true"></span></summary><div class="wp-block-group bwex-faq__a is-layout-flow wp-block-group-is-layout-flow"><p class="wp-block-paragraph">30 days free.</p></div></details><details class="wp-block-details bwex-faq__item bwex-faq__item--extra is-layout-flow wp-block-details-is-layout-flow"><summary><span class="bwex-faq__n" aria-hidden="true">07</span><span class="bwex-faq__q">Do you write copy?</span><span class="bwex-faq__icon" aria-hidden="true"></span></summary><div class="wp-block-group bwex-faq__a is-layout-flow wp-block-group-is-layout-flow"><p class="wp-block-paragraph">On request · extra.</p></div></details></div><button type="button" class="bwex-faq__toggle" aria-expanded="false" aria-controls="bwex-faq-test" data-more="Show 1 more question" data-less="Show fewer questions">Show 1 more question</button></div></div></div></div></section></div></div>