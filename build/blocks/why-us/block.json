          "prop": "max-width"
        }
      ]
    },
    {
      "key": "minHeight",
      "label": "Minimum height",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "min-height"
        }
      ]
    },
    {
      "key": "textAlign",
      "label": "Heading alignment",
      "panel": "Layout",
      "control": "select",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-head",
          "prop": "text-align"
        }
      ]
    },
    {
      "key": "bgColor",
      "label": "Background colour",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "bgImage",
      "label": "Background image",
      "panel": "Background",
      "control": "image",
      "rules": [
        {
          "sel": "",
          "prop": "background-image",
          "tpl": "url('{v}')"
        },
        {
          "sel": "",
          "prop": "background-size",
          "fixed": "cover"
        },
        {
          "sel": "",
          "prop": "background-position",
          "fixed": "center"
        },
        {
          "sel": "",
          "prop": "background-repeat",
          "fixed": "no-repeat"
        }
      ]
    },
    {
      "key": "overlay",
      "label": "Overlay colour (use transparency)",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "box-shadow",
          "tpl": "inset 0 0 0 100vmax {v}"
        }
      ]
    },
    {
      "key": "accent",
      "general": true,
      "label": "Highlight colour (italic words, lines, tags)",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "--bwex-accent"
        },
        {
          "sel": "",
          "prop": "--bwe-accent"
        },
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        },
        {
          "sel": " .bwex-h2 h2 em",
          "prop": "background-image",
          "tpl": "linear-gradient({v}, {v})"
        }
      ]
    },
    {
      "key": "textColor",
      "general": true,
      "label": "Text colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "color"
        },
        {
          "sel": " :where(p)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "linkColor",
      "general": true,
      "label": "Link colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": " :where(p a, li a:not(.wp-block-button__link))",
          "prop": "color"
        }
      ]
    },
    {
      "key": "textSize",
      "general": true,
      "label": "Text size",
      "panel": "Colours & text",
      "control": "unit",
      "rules": [
        {
          "sel": " :where(p)",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowColor",
      "label": "Colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "color"
        }
      ]
    },
    {
      "key": "eyebrowSize",
      "label": "Size",
      "panel": "Small label (above the heading)",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowChip",
      "label": "Icon box colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "hideEyebrowIcon",
      "label": "Hide the icon",
      "panel": "Small label (above the heading)",
      "control": "toggle",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "display",
          "valueMap": {
            "true": "none"
          }
        }
      ]
    },
    {
      "key": "titleSize",
      "label": "Size",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "titleSizeMobile",
      "label": "Size (phone)",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "titleColor",
      "label": "Colour",
      "panel": "Heading",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "color"
        }
      ]
    },
    {
      "key": "titleWeight",
      "label": "Weight",
      "panel": "Heading",
      "control": "select",
      "options": [
        {
          "label": "400 Regular",
          "value": "400"
        },
        {
          "label": "500 Medium",
          "value": "500"
        },
        {
          "label": "600 Semibold",
          "value": "600"
        },
        {
          "label": "700 Bold",
          "value": "700"
        },
        {
          "label": "800 Extra bold",
          "value": "800"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-weight"
        }
      ]
    },
    {
      "key": "titleLineHeight",
      "label": "Line height",
      "panel": "Heading",
      "control": "range",
      "min": 0.8,
      "max": 1.6,
      "step": 0.01,
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "line-height"
        }
      ]
    },
    {
      "key": "highlightText",
