      "panel": "Spec cards",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-spec__list > li",
          "prop": "padding"
        }
      ]
    },
    {
      "key": "cardShadow",
      "label": "Shadow",
      "panel": "Spec cards",
      "control": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Soft",
          "value": "soft"
        },
        {
          "label": "Strong",
          "value": "strong"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-spec__list > li",
          "prop": "box-shadow",
          "valueMap": {
            "none": "none",
            "soft": "0 18px 40px -28px rgba(17, 17, 17, .35)",
            "strong": "0 28px 60px -24px rgba(17, 17, 17, .55)"
          }
        }
      ]
    },
    {
      "key": "cardHoverBorder",
      "label": "Border on hover",
      "panel": "Spec cards",
      "control": "color",
      "rules": [
