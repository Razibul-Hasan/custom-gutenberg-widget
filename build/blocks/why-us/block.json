        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "tablet"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "tablet"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "tablet"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "tablet"
