{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bwe/why-us",
  "title": "Why us",
  "category": "bestwebexpert",
  "icon": "yes-alt",
  "description": "Why-us section: small label, heading (italic = highlight), intro, a list of feature cards (add, remove or move them) and a line under them. Every look setting is in the Styles tab.",
  "keywords": [
    "why us",
    "features",
    "spec",
    "benefits",
    "best web expert",
    "bwe"
  ],
  "textdomain": "bestwebexpert",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Why BestWebExpert"
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "default": "What Makes Us <em>The Right Partner</em>"
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "split": {
      "type": "boolean",
      "default": true
    },
    "sectionId": {
      "type": "string",
      "default": "spec"
    },
    "headingId": {
      "type": "string",
      "default": ""
    },
    "aside": {
      "type": "string",
      "default": ""
    },
    "showAside": {
      "type": "boolean",
      "default": true
    },
    "bweStyle": {
      "type": "object",
      "default": {}
    },
    "bweIcon": {
      "type": "object",
      "default": {}
    },
    "tone": {
      "type": "string",
      "default": "soft"
    },
    "headWrap": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "bwe-gw-editor",
  "render": "file:./render.php",
  "bweStyleMap": [
    {
      "key": "columns",
      "label": "Items per row (desktop)",
      "panel": "Layout",
      "control": "range",
      "min": 1,
      "max": 6,
      "rules": [
        {
          "sel": " .bwex-spec__list",
          "prop": "display",
          "fixed": "grid",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list",
          "prop": "grid-template-columns",
          "tpl": "repeat({v}, minmax(0, 1fr))",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list > *",
          "prop": "grid-column",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list > *",
          "prop": "width",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "white-space",
          "fixed": "normal",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "text-align",
          "fixed": "center",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "line-height",
          "fixed": "1.3",
          "media": "desktop"
        }
      ]
    },
    {
      "key": "columnsTablet",
      "label": "Items per row (tablet)",
      "panel": "Layout",
      "control": "range",
      "min": 1,
      "max": 4,
