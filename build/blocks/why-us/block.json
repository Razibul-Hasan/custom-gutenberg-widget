          "prop": "display",
          "fixed": "grid",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list",
          "prop": "grid-template-columns",
          "fixed": "repeat(auto-fit, minmax(min(100%, 200px), 1fr))",
          "media": "desktop"
        },
        {
          "sel": " .bwex-spec__list > *",
          "prop": "grid-column",
          "fixed": "auto",
          "media": "desktop"
        },
        {
