{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bwe/pricing",
  "title": "Pricing",
  "category": "bestwebexpert",
  "icon": "money-alt",
  "description": "Pricing section: heading, then price plans, the starting-prices card and the cost explainer (each can be removed, moved or added again). Every look setting is in the Styles tab.",
  "keywords": [
    "pricing",
    "plans",
    "prices",
    "packages",
    "best web expert",
    "bwe"
  ],
  "textdomain": "bestwebexpert",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "Pricing"
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "default": "Transparent Pricing. <em>Zero</em> Surprise Invoices."
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "split": {
      "type": "boolean",
      "default": true
    },
    "sectionId": {
      "type": "string",
      "default": "pricing"
    },
    "bweStyle": {
      "type": "object",
      "default": {}
    },
    "bweIcon": {
      "type": "object",
      "default": {}
    },
    "headingId": {
      "type": "string",
      "default": ""
    },
    "headElementId": {
      "type": "string",
      "default": "15dc625"
    },
    "more": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "bwe-gw-editor",
  "render": "file:./render.php",
  "bweStyleMap": [
    {
      "key": "paddingTop",
      "label": "Space above",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-top"
        }
      ]
    },
    {
      "key": "paddingBottom",
      "label": "Space below",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-bottom"
        }
      ]
    },
    {
      "key": "paddingTopMobile",
      "label": "Space above (phone)",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-top",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "paddingBottomMobile",
      "label": "Space below (phone)",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-bottom",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "contentWidth",
      "label": "Content width",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-wrap",
          "prop": "max-width"
        }
      ]
    },
    {
      "key": "minHeight",
      "label": "Minimum height",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "min-height"
        }
      ]
    },
    {
      "key": "textAlign",
      "label": "Heading alignment",
      "panel": "Layout",
      "control": "select",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-head",
          "prop": "text-align"
        }
      ]
    },
    {
      "key": "bgColor",
      "label": "Background colour",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "bgImage",
      "label": "Background image",
      "panel": "Background",
      "control": "image",
      "rules": [
        {
          "sel": "",
          "prop": "background-image",
          "tpl": "url('{v}')"
        },
        {
          "sel": "",
          "prop": "background-size",
          "fixed": "cover"
        },
        {
          "sel": "",
          "prop": "background-position",
          "fixed": "center"
        },
        {
          "sel": "",
          "prop": "background-repeat",
          "fixed": "no-repeat"
        }
      ]
    },
    {
      "key": "overlay",
      "label": "Overlay colour (use transparency)",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "box-shadow",
          "tpl": "inset 0 0 0 100vmax {v}"
        }
      ]
    },
    {
      "key": "accent",
      "general": true,
      "label": "Highlight colour (italic words, lines, tags)",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "--bwex-accent"
        },
        {
          "sel": "",
          "prop": "--bwe-accent"
        },
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        },
        {
          "sel": " .bwex-h2 h2 em",
          "prop": "background-image",
          "tpl": "linear-gradient({v}, {v})"
        }
      ]
    },
    {
      "key": "textColor",
      "general": true,
      "label": "Text colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "color"
        },
        {
          "sel": " :where(p)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "linkColor",
      "general": true,
      "label": "Link colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": " :where(p a, li a:not(.wp-block-button__link))",
          "prop": "color"
        }
      ]
    },
    {
      "key": "textSize",
      "general": true,
      "label": "Text size",
      "panel": "Colours & text",
      "control": "unit",
      "rules": [
        {
          "sel": " :where(p)",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowColor",
      "label": "Colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "color"
        }
      ]
    },
    {
      "key": "eyebrowSize",
      "label": "Size",
      "panel": "Small label (above the heading)",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowChip",
      "label": "Icon box colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "hideEyebrowIcon",
      "label": "Hide the icon",
      "panel": "Small label (above the heading)",
      "control": "toggle",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "display",
          "valueMap": {
            "true": "none"
          }
        }
      ]
    },
    {
      "key": "titleSize",
      "label": "Size",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "titleSizeMobile",
      "label": "Size (phone)",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "titleColor",
      "label": "Colour",
      "panel": "Heading",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "color"
        }
      ]
    },
    {
      "key": "titleWeight",
      "label": "Weight",
      "panel": "Heading",
      "control": "select",
      "options": [
        {
          "label": "400 Regular",
          "value": "400"
        },
        {
          "label": "500 Medium",
          "value": "500"
        },
        {
          "label": "600 Semibold",
          "value": "600"
        },
        {
          "label": "700 Bold",
          "value": "700"
        },
        {
          "label": "800 Extra bold",
          "value": "800"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-weight"
        }
      ]
    },
    {
      "key": "titleLineHeight",
      "label": "Line height",
      "panel": "Heading",
      "control": "range",
      "min": 0.8,
      "max": 1.6,
      "step": 0.01,
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "line-height"
        }
      ]
    },
    {
      "key": "highlightText",
      "label": "Highlighted words colour",
      "panel": "Heading",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h2 h2 em",
          "prop": "color"
        }
      ]
    },
    {
      "key": "introColor",
      "label": "Colour",
      "panel": "Intro",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "color"
        }
      ]
    },
    {
      "key": "introSize",
      "label": "Size",
      "panel": "Intro",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "introWidth",
      "label": "Max width",
      "panel": "Intro",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "max-width"
        }
      ]
    },
    {
      "key": "planBg",
      "label": "Background",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan",
          "prop": "background-color"
        }
      ],
      "general": true
    },
    {
      "key": "planBorder",
      "label": "Border colour",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan",
          "prop": "border-color"
        }
      ]
    },
    {
      "key": "planRadius",
      "label": "Corner radius",
      "panel": "Plan cards",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-plan",
          "prop": "border-radius"
        }
      ]
    },
    {
      "key": "planName",
      "label": "Plan name colour",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan h3",
          "prop": "color"
        }
      ]
    },
    {
      "key": "planPrice",
      "label": "Price colour",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan__price",
          "prop": "color"
        }
      ]
    },
    {
      "key": "planPriceSize",
      "label": "Price size",
      "panel": "Plan cards",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-plan__price",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "planText",
      "label": "Text colour",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-plan__desc, .bwex-checks li)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "featuredBg",
      "label": "Featured plan background",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan--featured",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "badgeBg",
      "label": "Badge background",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan__badge",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "badgeColor",
      "label": "Badge text",
      "panel": "Plan cards",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan__badge",
          "prop": "color"
        }
      ]
    },
    {
      "key": "btnBg",
      "label": "Background",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "btnText",
      "label": "Text colour",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link",
          "prop": "color"
        }
      ]
    },
    {
      "key": "btnBorder",
      "label": "Border colour",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link",
          "prop": "border-color"
        }
      ]
    },
    {
      "key": "btnRadius",
      "label": "Corner radius",
      "panel": "Buttons",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link",
          "prop": "border-radius"
        }
      ]
    },
    {
      "key": "btnSize",
      "label": "Text size",
      "panel": "Buttons",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "btnHoverBg",
      "label": "Background on hover",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link:hover",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "btnHoverText",
      "label": "Text on hover",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plan .wp-block-button__link:hover",
          "prop": "color"
        }
      ]
    }
  ]
}