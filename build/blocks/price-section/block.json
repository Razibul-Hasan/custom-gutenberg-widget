      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h3 .elementor-heading-title",
          "prop": "font-size",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "cardTitleColor",
      "label": "Colour",
      "panel": "Card title",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h3 .elementor-heading-title",
          "prop": "color"
        },
        {
          "sel": " .bwex-h3 .elementor-heading-title a",
          "prop": "color"
        }
      ]
    },
    {
      "key": "cardTitleHover",
