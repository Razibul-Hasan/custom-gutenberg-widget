      "control": "color",
      "rules": [
        {
          "sel": " .bwex-plat__chip::before",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "hideChipDot",
      "label": "Hide the dot",
      "panel": "Small tag",
      "control": "toggle",
      "rules": [
        {
          "sel": " .bwex-plat__chip::before",
          "prop": "display",
          "valueMap": {
            "true": "none"
          }
        }
      ]
    },
    {
      "key": "titleSize",
