{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bwe/plans",
  "title": "Price plans",
  "category": "bestwebexpert",
  "icon": "columns",
  "description": "A row of price plan cards: add, remove or move plans; mark one as featured.",
  "keywords": [
    "pricing",
    "plans",
    "packages",
    "best web expert",
    "bwe"
  ],
  "textdomain": "bestwebexpert",
  "attributes": {
    "bweStyle": {
      "type": "object",
      "default": {}
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "bwe-gw-editor",
  "render": "file:./render.php",
  "bweStyleMap": [
    {
      "key": "columns",
      "label": "Columns (desktop)",
      "panel": "Layout",
      "control": "range",
      "min": 1,
      "max": 4,
      "rules": [
        {
          "sel": "",
          "prop": "grid-template-columns",
          "tpl": "repeat({v}, minmax(0, 1fr))",
          "media": "desktop"
        },
        {
          "sel": "",
          "prop": "display",
          "fixed": "grid",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "white-space",
          "fixed": "normal",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "text-align",
          "fixed": "center",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "line-height",
          "fixed": "1.3",
          "media": "desktop"
        }
      ]
    },
    {
      "key": "columnsTablet",
      "label": "Columns (tablet)",
      "panel": "Layout",
      "control": "range",
      "min": 1,
      "max": 3,
      "rules": [
        {
          "sel": "",
          "prop": "grid-template-columns",
          "tpl": "repeat({v}, minmax(0, 1fr))",
          "media": "tablet"
        },
        {
          "sel": "",
          "prop": "display",
          "fixed": "grid",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "white-space",
          "fixed": "normal",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "text-align",
          "fixed": "center",
          "media": "tablet"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "line-height",
          "fixed": "1.3",
          "media": "tablet"
        }
      ]
    },
    {
      "key": "columnsMobile",
      "label": "Items per row (phone)",
      "panel": "Layout",
      "control": "range",
      "min": 1,
      "max": 3,
      "rules": [
        {
          "sel": "",
          "prop": "display",
          "fixed": "grid",
          "media": "mobile"
        },
        {
          "sel": "",
          "prop": "grid-template-columns",
          "tpl": "repeat({v}, minmax(0, 1fr))",
          "media": "mobile"
        },
        {
          "sel": " > *",
          "prop": "grid-column",
          "fixed": "auto",
          "media": "mobile"
        },
        {
          "sel": " > *",
          "prop": "width",
          "fixed": "auto",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "white-space",
          "fixed": "normal",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "text-align",
          "fixed": "center",
          "media": "mobile"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "line-height",
          "fixed": "1.3",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "oneRow",
      "label": "All items on one row (desktop, while they fit)",
      "panel": "Layout",
      "control": "toggle",
      "rules": [
        {
          "sel": "",
          "prop": "display",
          "fixed": "grid",
          "media": "desktop"
        },
        {
          "sel": "",
          "prop": "grid-template-columns",
          "fixed": "repeat(auto-fit, minmax(min(100%, 200px), 1fr))",
          "media": "desktop"
        },
        {
          "sel": " > *",
          "prop": "grid-column",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " > *",
          "prop": "width",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "white-space",
          "fixed": "normal",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "height",
          "fixed": "auto",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "min-height",
          "fixed": "40px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-top",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "padding-bottom",
          "fixed": "8px",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "text-align",
          "fixed": "center",
          "media": "desktop"
        },
        {
          "sel": " :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
          "prop": "line-height",
          "fixed": "1.3",
          "media": "desktop"
        }
      ]
    },
    {
      "key": "gap",
      "label": "Space between plans",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "gap"
        }
      ]
    },
    {
      "key": "marginTop",
      "label": "Space above",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "margin-top"
        }
      ]
    },
    {
      "key": "marginBottom",
      "label": "Space below",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "margin-bottom"
        }
      ]
    }
  ]
}