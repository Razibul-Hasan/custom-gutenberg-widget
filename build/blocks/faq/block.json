{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "bwe/faq",
  "title": "FAQ",
  "category": "bestwebexpert",
  "icon": "editor-help",
  "description": "FAQ section: heading and \"ask a question\" button on one side, numbered questions on the other (add, remove or move them; mark some as hidden until \"Show more\"). Questions also feed the FAQ schema.",
  "keywords": [
    "faq",
    "questions",
    "accordion",
    "answers",
    "best web expert",
    "bwe"
  ],
  "textdomain": "bestwebexpert",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": "FAQ"
    },
    "showEyebrow": {
      "type": "boolean",
      "default": true
    },
    "title": {
      "type": "string",
      "default": "Frequently Asked <em>Questions</em>"
    },
    "intro": {
      "type": "string",
      "default": ""
    },
    "showIntro": {
      "type": "boolean",
      "default": true
    },
    "split": {
      "type": "boolean",
      "default": false
    },
    "sectionId": {
      "type": "string",
      "default": "faq"
    },
    "headElementId": {
      "type": "string",
      "default": "b4093ad"
    },
    "askText": {
      "type": "string",
      "default": "Ask a question →"
    },
    "askUrl": {
      "type": "string",
      "default": "/contact/"
    },
    "askNewTab": {
      "type": "boolean",
      "default": false
    },
    "showAsk": {
      "type": "boolean",
      "default": true
    },
    "toggleText": {
      "type": "string",
      "default": ""
    },
    "listId": {
      "type": "string",
      "default": ""
    },
    "bweStyle": {
      "type": "object",
      "default": {}
    },
    "bweIcon": {
      "type": "object",
      "default": {}
    },
    "headingId": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "bwe-gw-editor",
  "render": "file:./render.php",
  "bweStyleMap": [
    {
      "key": "paddingTop",
      "label": "Space above",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-top"
        }
      ]
    },
    {
      "key": "paddingBottom",
      "label": "Space below",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-bottom"
        }
      ]
    },
    {
      "key": "paddingTopMobile",
      "label": "Space above (phone)",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-top",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "paddingBottomMobile",
      "label": "Space below (phone)",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "padding-bottom",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "contentWidth",
      "label": "Content width",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-wrap",
          "prop": "max-width"
        }
      ]
    },
    {
      "key": "minHeight",
      "label": "Minimum height",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": "",
          "prop": "min-height"
        }
      ]
    },
    {
      "key": "textAlign",
      "label": "Heading alignment",
      "panel": "Layout",
      "control": "select",
      "options": [
        {
          "label": "Left",
          "value": "left"
        },
        {
          "label": "Centre",
          "value": "center"
        },
        {
          "label": "Right",
          "value": "right"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-head",
          "prop": "text-align"
        }
      ]
    },
    {
      "key": "bgColor",
      "label": "Background colour",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "bgImage",
      "label": "Background image",
      "panel": "Background",
      "control": "image",
      "rules": [
        {
          "sel": "",
          "prop": "background-image",
          "tpl": "url('{v}')"
        },
        {
          "sel": "",
          "prop": "background-size",
          "fixed": "cover"
        },
        {
          "sel": "",
          "prop": "background-position",
          "fixed": "center"
        },
        {
          "sel": "",
          "prop": "background-repeat",
          "fixed": "no-repeat"
        }
      ]
    },
    {
      "key": "overlay",
      "label": "Overlay colour (use transparency)",
      "panel": "Background",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "box-shadow",
          "tpl": "inset 0 0 0 100vmax {v}"
        }
      ]
    },
    {
      "key": "accent",
      "general": true,
      "label": "Highlight colour (italic words, lines, tags)",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "--bwex-accent"
        },
        {
          "sel": "",
          "prop": "--bwe-accent"
        },
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        },
        {
          "sel": " .bwex-h2 h2 em",
          "prop": "background-image",
          "tpl": "linear-gradient({v}, {v})"
        }
      ]
    },
    {
      "key": "textColor",
      "general": true,
      "label": "Text colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": "",
          "prop": "color"
        },
        {
          "sel": " :where(p)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "linkColor",
      "general": true,
      "label": "Link colour",
      "panel": "Colours & text",
      "control": "color",
      "rules": [
        {
          "sel": " :where(p a, li a:not(.wp-block-button__link))",
          "prop": "color"
        }
      ]
    },
    {
      "key": "textSize",
      "general": true,
      "label": "Text size",
      "panel": "Colours & text",
      "control": "unit",
      "rules": [
        {
          "sel": " :where(p)",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowColor",
      "label": "Colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "color"
        }
      ]
    },
    {
      "key": "eyebrowSize",
      "label": "Size",
      "panel": "Small label (above the heading)",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-eyebrow p",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "eyebrowChip",
      "label": "Icon box colour",
      "panel": "Small label (above the heading)",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "hideEyebrowIcon",
      "label": "Hide the icon",
      "panel": "Small label (above the heading)",
      "control": "toggle",
      "rules": [
        {
          "sel": " .bwex-eyebrow p::before",
          "prop": "display",
          "valueMap": {
            "true": "none"
          }
        }
      ]
    },
    {
      "key": "titleSize",
      "label": "Size",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "titleSizeMobile",
      "label": "Size (phone)",
      "panel": "Heading",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-size",
          "media": "mobile"
        }
      ]
    },
    {
      "key": "titleColor",
      "label": "Colour",
      "panel": "Heading",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "color"
        }
      ]
    },
    {
      "key": "titleWeight",
      "label": "Weight",
      "panel": "Heading",
      "control": "select",
      "options": [
        {
          "label": "400 Regular",
          "value": "400"
        },
        {
          "label": "500 Medium",
          "value": "500"
        },
        {
          "label": "600 Semibold",
          "value": "600"
        },
        {
          "label": "700 Bold",
          "value": "700"
        },
        {
          "label": "800 Extra bold",
          "value": "800"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "font-weight"
        }
      ]
    },
    {
      "key": "titleLineHeight",
      "label": "Line height",
      "panel": "Heading",
      "control": "range",
      "min": 0.8,
      "max": 1.6,
      "step": 0.01,
      "rules": [
        {
          "sel": " .bwex-h2 h2",
          "prop": "line-height"
        }
      ]
    },
    {
      "key": "highlightText",
      "label": "Highlighted words colour",
      "panel": "Heading",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-h2 h2 em",
          "prop": "color"
        }
      ]
    },
    {
      "key": "introColor",
      "label": "Colour",
      "panel": "Intro",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "color"
        }
      ]
    },
    {
      "key": "introSize",
      "label": "Size",
      "panel": "Intro",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "introWidth",
      "label": "Max width",
      "panel": "Intro",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-intro p",
          "prop": "max-width"
        }
      ]
    },
    {
      "key": "cardBg",
      "label": "Background",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__item",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "cardBorder",
      "label": "Border colour",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__item",
          "prop": "border-color"
        }
      ]
    },
    {
      "key": "cardRadius",
      "label": "Corner radius",
      "panel": "Questions",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq__item",
          "prop": "border-radius"
        }
      ]
    },
    {
      "key": "cardPadding",
      "label": "Inner space",
      "panel": "Questions",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq__item",
          "prop": "padding"
        }
      ]
    },
    {
      "key": "cardShadow",
      "label": "Shadow",
      "panel": "Questions",
      "control": "select",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "Soft",
          "value": "soft"
        },
        {
          "label": "Strong",
          "value": "strong"
        }
      ],
      "rules": [
        {
          "sel": " .bwex-faq__item",
          "prop": "box-shadow",
          "valueMap": {
            "none": "none",
            "soft": "0 18px 40px -28px rgba(17, 17, 17, .35)",
            "strong": "0 28px 60px -24px rgba(17, 17, 17, .55)"
          }
        }
      ]
    },
    {
      "key": "cardHoverBorder",
      "label": "Border on hover",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__item:hover",
          "prop": "border-color"
        }
      ]
    },
    {
      "key": "cardTitleColor",
      "label": "Title colour",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__q",
          "prop": "color"
        }
      ]
    },
    {
      "key": "cardTitleSize",
      "label": "Title size",
      "panel": "Questions",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq__q",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "cardTextColor",
      "label": "Text colour",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__a :is(p, li)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "cardTextSize",
      "label": "Text size",
      "panel": "Questions",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq__a :is(p, li)",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "numColor",
      "label": "Number colour",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__n",
          "prop": "color"
        }
      ]
    },
    {
      "key": "hideNum",
      "label": "Hide the numbers",
      "panel": "Questions",
      "control": "toggle",
      "rules": [
        {
          "sel": " .bwex-faq__n",
          "prop": "display",
          "valueMap": {
            "true": "none"
          }
        }
      ]
    },
    {
      "key": "iconColor",
      "label": "Plus icon colour",
      "panel": "Questions",
      "control": "color",
      "rules": [
        {
          "sel": " .bwex-faq__icon",
          "prop": "color"
        }
      ]
    },
    {
      "key": "itemGap",
      "label": "Space between questions",
      "panel": "Questions",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq",
          "prop": "gap"
        }
      ]
    },
    {
      "key": "introWidthSide",
      "label": "Left column width",
      "panel": "Layout",
      "control": "unit",
      "rules": [
        {
          "sel": " .bwex-faq__grid",
          "prop": "grid-template-columns",
          "tpl": "{v} minmax(0, 1fr)",
          "media": "desktop"
        }
      ]
    },
    {
      "key": "btnBg",
      "label": "Background",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle)",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "btnText",
      "label": "Text colour",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle)",
          "prop": "color"
        }
      ]
    },
    {
      "key": "btnBorder",
      "label": "Border colour",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle)",
          "prop": "border-color"
        }
      ]
    },
    {
      "key": "btnRadius",
      "label": "Corner radius",
      "panel": "Buttons",
      "control": "unit",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle)",
          "prop": "border-radius"
        }
      ]
    },
    {
      "key": "btnSize",
      "label": "Text size",
      "panel": "Buttons",
      "control": "unit",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle)",
          "prop": "font-size"
        }
      ]
    },
    {
      "key": "btnHoverBg",
      "label": "Background on hover",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle):hover",
          "prop": "background-color"
        }
      ]
    },
    {
      "key": "btnHoverText",
      "label": "Text on hover",
      "panel": "Buttons",
      "control": "color",
      "rules": [
        {
          "sel": " :is(.bwex-btn .elementor-button, .bwex-faq__toggle):hover",
          "prop": "color"
        }
      ]
    }
  ]
}