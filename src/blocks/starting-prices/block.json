					"fixed": "1.3",
					"media": "tablet"
				}
			]
		},
		{
			"key": "columnsMobile",
			"label": "Columns (phone)",
			"panel": "Price rows",
			"control": "range",
			"min": 1,
			"max": 2,
			"rules": [
				{
