{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bwe/starting-prices",
	"title": "Starting prices",
	"category": "bestwebexpert",
	"icon": "tickets-alt",
	"description": "Starting-prices card: a label, linked \"service — from $X\" rows (add, remove or move them), a note and a link to every price.",
	"keywords": [
		"prices",
		"pricing",
		"from",
		"cost",
		"best web expert",
		"bwe"
	],
	"textdomain": "bestwebexpert",
	"attributes": {
		"label": {
			"type": "string",
			"default": "Starting prices"
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		},
		"items": {
			"type": "array",
			"default": [
				{
					"label": "WordPress website",
					"price": "from $250",
					"url": "/pricing/#wordpress-prices"
				},
				{
					"label": "Shopify store",
					"price": "from $250",
					"url": "/pricing/#shopify-prices"
				},
				{
					"label": "WooCommerce store",
					"price": "from $400",
					"url": "/pricing/#wordpress-prices"
				}
			]
		},
		"note": {
			"type": "string",
			"default": "You’ll get a fixed, written quote after your free strategy call."
		},
		"showNote": {
			"type": "boolean",
			"default": true
		},
		"allText": {
			"type": "string",
			"default": "See every plan and price →"
		},
		"allUrl": {
			"type": "string",
			"default": "/pricing/"
		},
		"showAll": {
			"type": "boolean",
			"default": true
		},
		"bweStyle": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "bwe-gw-editor",
	"render": "file:./render.php",
	"bweStyleMap": [
		{
			"key": "bg",
			"label": "Background",
			"panel": "Card",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "border",
			"label": "Border colour",
			"panel": "Card",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "radius",
			"label": "Corner radius",
			"panel": "Card",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "border-radius"
				}
			]
		},
		{
			"key": "padding",
			"label": "Inner space",
			"panel": "Card",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding"
				}
			]
		},
		{
			"key": "marginTop",
			"label": "Space above",
			"panel": "Card",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "margin-top"
				}
			]
		},
		{
			"key": "labelColor",
			"label": "Label colour",
			"panel": "Text",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-pricenote__label",
					"prop": "color"
				}
			]
		},
		{
			"key": "noteColor",
			"label": "Note colour",
			"panel": "Text",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-pricenote__note",
					"prop": "color"
				}
			]
		},
		{
			"key": "columns",
			"label": "Columns (desktop)",
			"panel": "Price rows",
			"control": "range",
			"min": 1,
			"max": 4,
			"rules": [
				{
					"sel": " .bwex-pricenote__list",
					"prop": "grid-template-columns",
					"tpl": "repeat({v}, minmax(0, 1fr))",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list",
					"prop": "display",
					"fixed": "grid",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "white-space",
					"fixed": "normal",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "height",
					"fixed": "auto",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "min-height",
					"fixed": "40px",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "padding-top",
					"fixed": "8px",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "padding-bottom",
					"fixed": "8px",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "text-align",
					"fixed": "center",
					"media": "desktop"
				},
				{
					"sel": " .bwex-pricenote__list :is(.wp-block-button__link, .elementor-button, .bwex-card__btn)",
					"prop": "line-height",
					"fixed": "1.3",
					"media": "desktop"
				}
			]
		},
