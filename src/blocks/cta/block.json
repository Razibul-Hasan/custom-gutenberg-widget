{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bwe/cta",
	"title": "Call to action",
	"category": "bestwebexpert",
	"icon": "megaphone",
	"description": "The dark closing box (\"Ready when you are\"): small label, heading, text, two buttons, the live-chat line (its link opens the chat) and a small note. Every look setting is in the Styles tab.",
	"keywords": [
		"cta",
		"call to action",
		"closing",
		"contact",
		"ready",
		"best web expert",
		"bwe"
	],
	"textdomain": "bestwebexpert",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Ready when you are"
		},
		"showEyebrow": {
			"type": "boolean",
			"default": true
		},
		"title": {
			"type": "string",
			"default": "Still Scrolling? <em>That’s a Sign.</em>"
		},
		"lead": {
			"type": "string",
			"default": ""
		},
		"btn1Text": {
			"type": "string",
			"default": "Claim my free audit →"
		},
		"btn1Url": {
			"type": "string",
			"default": "/contact/"
		},
		"btn2Text": {
			"type": "string",
			"default": "See pricing"
		},
		"btn2Url": {
			"type": "string",
			"default": "/pricing/"
		},
		"showBtn2": {
			"type": "boolean",
			"default": true
		},
		"btn1NewTab": {
			"type": "boolean",
			"default": false
		},
		"btn2NewTab": {
			"type": "boolean",
			"default": false
		},
		"chat": {
			"type": "string",
			"default": "Prefer to chat? I'm on <strong>live chat 24/7</strong>. <a href=\"/contact/\">Start a chat →</a>"
		},
		"showChat": {
			"type": "boolean",
			"default": true
		},
		"note": {
			"type": "string",
			"default": "No pressure. No sales pitch. Just honest advice."
		},
		"showNote": {
			"type": "boolean",
			"default": true
		},
		"sectionId": {
			"type": "string",
			"default": ""
		},
		"bweStyle": {
			"type": "object",
			"default": {}
		},
		"bweIcon": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "bwe-gw-editor",
	"render": "file:./render.php",
	"bweStyleMap": [
		{
			"key": "paddingTop",
			"label": "Space above",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-top"
				}
			]
		},
		{
			"key": "paddingBottom",
			"label": "Space below",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-bottom"
				}
			]
		},
		{
			"key": "paddingTopMobile",
			"label": "Space above (phone)",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-top",
					"media": "mobile"
				}
			]
		},
		{
			"key": "paddingBottomMobile",
			"label": "Space below (phone)",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-bottom",
					"media": "mobile"
				}
			]
		},
		{
			"key": "contentWidth",
			"label": "Content width",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-final__box",
					"prop": "max-width"
				}
			]
		},
		{
			"key": "minHeight",
			"label": "Minimum height",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "min-height"
				}
			]
		},
		{
			"key": "textAlign",
			"label": "Heading alignment",
			"panel": "Layout",
			"control": "select",
			"options": [
				{
					"label": "Left",
					"value": "left"
				},
				{
					"label": "Centre",
					"value": "center"
				},
				{
					"label": "Right",
					"value": "right"
				}
			],
			"rules": [
				{
					"sel": " .bwe-final__box",
					"prop": "text-align"
				}
			]
		},
		{
			"key": "bgColor",
			"label": "Background colour",
			"panel": "Background",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "hideDecor",
			"general": true,
			"label": "Hide background decorations (glow, grid)",
			"panel": "Background",
			"control": "toggle",
			"rules": [
				{
					"sel": "",
					"prop": "background-image",
					"valueMap": {
						"true": "none"
					}
				},
				{
					"sel": "::before",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				},
				{
					"sel": "::after",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				},
				{
					"sel": " .bwe-final__box",
					"prop": "background-image",
					"valueMap": {
						"true": "none"
					}
				},
				{
					"sel": " .bwe-final__box::before",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				},
				{
					"sel": " .bwe-final__box::after",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				}
			]
		},
		{
			"key": "bgImage",
			"label": "Background image",
			"panel": "Background",
			"control": "image",
			"rules": [
				{
					"sel": "",
					"prop": "background-image",
					"tpl": "url('{v}')"
				},
				{
					"sel": "",
					"prop": "background-size",
					"fixed": "cover"
				},
				{
					"sel": "",
					"prop": "background-position",
					"fixed": "center"
				},
				{
					"sel": "",
					"prop": "background-repeat",
					"fixed": "no-repeat"
				}
			]
		},
		{
			"key": "overlay",
			"label": "Overlay colour (use transparency)",
			"panel": "Background",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "box-shadow",
					"tpl": "inset 0 0 0 100vmax {v}"
				}
			]
		},
		{
			"key": "accent",
			"general": true,
			"label": "Highlight colour (italic words, lines, tags)",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "--bwex-accent"
				},
				{
					"sel": "",
					"prop": "--bwe-accent"
				},
				{
					"sel": " p.bwe-eyebrow::before",
					"prop": "background-color"
				},
				{
					"sel": " .bwe-final__box > h2 em",
					"prop": "background-image",
					"tpl": "linear-gradient({v}, {v})"
				}
			]
		},
		{
			"key": "textColor",
			"general": true,
			"label": "Text colour",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "color"
				},
				{
					"sel": " :where(p)",
					"prop": "color"
				}
			]
		},
		{
			"key": "linkColor",
			"general": true,
			"label": "Link colour",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": " :where(p a, li a:not(.wp-block-button__link))",
					"prop": "color"
				}
			]
		},
		{
			"key": "textSize",
			"general": true,
			"label": "Text size",
			"panel": "Colours & text",
			"control": "unit",
			"rules": [
				{
					"sel": " :where(p)",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "eyebrowColor",
			"label": "Colour",
			"panel": "Small label (above the heading)",
			"control": "color",
			"rules": [
				{
					"sel": " p.bwe-eyebrow",
					"prop": "color"
				}
			]
		},
		{
			"key": "eyebrowSize",
			"label": "Size",
			"panel": "Small label (above the heading)",
			"control": "unit",
			"rules": [
				{
					"sel": " p.bwe-eyebrow",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "eyebrowChip",
			"label": "Icon box colour",
			"panel": "Small label (above the heading)",
			"control": "color",
			"rules": [
				{
					"sel": " p.bwe-eyebrow::before",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "hideEyebrowIcon",
			"label": "Hide the icon",
			"panel": "Small label (above the heading)",
			"control": "toggle",
			"rules": [
				{
					"sel": " p.bwe-eyebrow::before",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				}
			]
		},
		{
			"key": "titleSize",
			"label": "Size",
			"panel": "Heading",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-final__box > h2",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "titleSizeMobile",
			"label": "Size (phone)",
			"panel": "Heading",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-final__box > h2",
					"prop": "font-size",
					"media": "mobile"
				}
			]
		},
		{
			"key": "titleColor",
			"label": "Colour",
			"panel": "Heading",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-final__box > h2",
					"prop": "color"
				}
			]
		},
		{
			"key": "titleWeight",
			"label": "Weight",
			"panel": "Heading",
			"control": "select",
			"options": [
				{
					"label": "400 Regular",
					"value": "400"
				},
				{
					"label": "500 Medium",
					"value": "500"
				},
				{
					"label": "600 Semibold",
					"value": "600"
				},
				{
					"label": "700 Bold",
					"value": "700"
				},
				{
					"label": "800 Extra bold",
					"value": "800"
				}
			],
			"rules": [
				{
					"sel": " .bwe-final__box > h2",
					"prop": "font-weight"
				}
			]
		},
		{
			"key": "titleLineHeight",
			"label": "Line height",
			"panel": "Heading",
			"control": "range",
			"min": 0.8,
			"max": 1.6,
			"step": 0.01,
			"rules": [
				{
					"sel": " .bwe-final__box > h2",
					"prop": "line-height"
				}
			]
		},
		{
			"key": "highlightText",
			"label": "Highlighted words colour",
			"panel": "Heading",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-final__box > h2 em",
					"prop": "color"
				}
			]
		},
		{
			"key": "introColor",
			"label": "Colour",
			"panel": "Intro",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-final__box > .bwe-lead",
					"prop": "color"
				}
			]
		},
		{
			"key": "introSize",
			"label": "Size",
