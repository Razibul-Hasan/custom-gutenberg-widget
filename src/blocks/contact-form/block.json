			]
		},
		{
			"key": "choiceText",
			"label": "Text",
			"panel": "Choice buttons",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-list-item label",
					"prop": "color"
				}
			]
		},
		{
			"key": "choiceBorder",
			"label": "Border",
			"panel": "Choice buttons",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-list-item label",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "choiceOnBg",
			"label": "Selected choice: background",
