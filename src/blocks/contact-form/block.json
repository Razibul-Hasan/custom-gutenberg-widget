{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bwe/contact-form",
	"title": "Contact form section",
	"category": "bestwebexpert",
	"icon": "email-alt",
	"description": "Small label, heading and intro beside a Contact Form 7 form in its card. Pick the form in the sidebar; every look setting (layout, card, fields, buttons) is in the Styles tab.",
	"keywords": [
		"contact",
		"form",
		"enquiry",
		"pitch",
		"contact form 7",
		"cf7",
		"best web expert",
		"bwe"
	],
	"textdomain": "bestwebexpert",
	"attributes": {
		"eyebrow": {
			"type": "string",
			"default": "Send a message"
		},
		"showEyebrow": {
			"type": "boolean",
			"default": true
		},
		"title": {
			"type": "string",
			"default": "Tell Me About Your Project. <em>I’ll Do the Rest.</em>"
		},
		"headingId": {
			"type": "string",
			"default": ""
		},
		"intro": {
			"type": "string",
			"default": "A few lines is plenty. Every enquiry with a website link gets a free mini audit: three quick wins for speed, SEO and sales."
		},
		"note": {
			"type": "string",
			"default": ""
		},
		"form": {
			"type": "string",
			"default": ""
		},
		"sectionId": {
			"type": "string",
			"default": "form"
		},
		"classes": {
			"type": "string",
			"default": "bwex-section bwex-wfu-form"
		},
		"cardClasses": {
			"type": "string",
			"default": "bwe-home bwe-services bwe-contact bwe-form-card"
		},
		"scope": {
			"type": "boolean",
			"default": true
		},
		"bweStyle": {
			"type": "object",
			"default": {}
		},
		"bweIcon": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false
	},
	"editorScript": "bwe-gw-editor",
	"render": "file:./render.php",
	"bweStyleMap": [
		{
			"key": "paddingTop",
			"label": "Space above",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-top"
				}
			]
		},
		{
			"key": "paddingBottom",
			"label": "Space below",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-bottom"
				}
			]
		},
		{
			"key": "paddingTopMobile",
			"label": "Space above (phone)",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-top",
					"media": "mobile"
				}
			]
		},
		{
			"key": "paddingBottomMobile",
			"label": "Space below (phone)",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "padding-bottom",
					"media": "mobile"
				}
			]
		},
		{
			"key": "contentWidth",
			"label": "Content width",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-wrap",
					"prop": "max-width"
				}
			]
		},
		{
			"key": "minHeight",
			"label": "Minimum height",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": "",
					"prop": "min-height"
				}
			]
		},
		{
			"key": "bgColor",
			"label": "Background colour",
			"panel": "Background",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "bgImage",
			"label": "Background image",
			"panel": "Background",
			"control": "image",
			"rules": [
				{
					"sel": "",
					"prop": "background-image",
					"tpl": "url('{v}')"
				},
				{
					"sel": "",
					"prop": "background-size",
					"fixed": "cover"
				},
				{
					"sel": "",
					"prop": "background-position",
					"fixed": "center"
				},
				{
					"sel": "",
					"prop": "background-repeat",
					"fixed": "no-repeat"
				}
			]
		},
		{
			"key": "overlay",
			"label": "Overlay colour (use transparency)",
			"panel": "Background",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "box-shadow",
					"tpl": "inset 0 0 0 100vmax {v}"
				}
			]
		},
		{
			"key": "accent",
			"general": true,
			"label": "Highlight colour (italic words, lines, tags)",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "--bwex-accent"
				},
				{
					"sel": "",
					"prop": "--bwe-accent"
				},
				{
					"sel": " .bwex-eyebrow p::before",
					"prop": "background-color"
				},
				{
					"sel": " .bwex-h2 h2 em",
					"prop": "background-image",
					"tpl": "linear-gradient({v}, {v})"
				}
			]
		},
		{
			"key": "textColor",
			"general": true,
			"label": "Text colour",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": "",
					"prop": "color"
				},
				{
					"sel": " :where(p)",
					"prop": "color"
				}
			]
		},
		{
			"key": "linkColor",
			"general": true,
			"label": "Link colour",
			"panel": "Colours & text",
			"control": "color",
			"rules": [
				{
					"sel": " :where(p a, li a:not(.wp-block-button__link))",
					"prop": "color"
				}
			]
		},
		{
			"key": "textSize",
			"general": true,
			"label": "Text size",
			"panel": "Colours & text",
			"control": "unit",
			"rules": [
				{
					"sel": " :where(p)",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "eyebrowColor",
			"label": "Colour",
			"panel": "Small label (above the heading)",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-eyebrow p",
					"prop": "color"
				}
			]
		},
		{
			"key": "eyebrowSize",
			"label": "Size",
			"panel": "Small label (above the heading)",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-eyebrow p",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "eyebrowChip",
			"label": "Icon box colour",
			"panel": "Small label (above the heading)",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-eyebrow p::before",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "hideEyebrowIcon",
			"label": "Hide the icon",
			"panel": "Small label (above the heading)",
			"control": "toggle",
			"rules": [
				{
					"sel": " .bwex-eyebrow p::before",
					"prop": "display",
					"valueMap": {
						"true": "none"
					}
				}
			]
		},
		{
			"key": "titleSize",
			"label": "Size",
			"panel": "Heading",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-h2 h2",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "titleSizeMobile",
			"label": "Size (phone)",
			"panel": "Heading",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-h2 h2",
					"prop": "font-size",
					"media": "mobile"
				}
			]
		},
		{
			"key": "titleColor",
			"label": "Colour",
			"panel": "Heading",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-h2 h2",
					"prop": "color"
				}
			]
		},
		{
			"key": "titleWeight",
			"label": "Weight",
			"panel": "Heading",
			"control": "select",
			"options": [
				{
					"label": "400 Regular",
					"value": "400"
				},
				{
					"label": "500 Medium",
					"value": "500"
				},
				{
					"label": "600 Semibold",
					"value": "600"
				},
				{
					"label": "700 Bold",
					"value": "700"
				},
				{
					"label": "800 Extra bold",
					"value": "800"
				}
			],
			"rules": [
				{
					"sel": " .bwex-h2 h2",
					"prop": "font-weight"
				}
			]
		},
		{
			"key": "titleLineHeight",
			"label": "Line height",
			"panel": "Heading",
			"control": "range",
			"min": 0.8,
			"max": 1.6,
			"step": 0.01,
			"rules": [
				{
					"sel": " .bwex-h2 h2",
					"prop": "line-height"
				}
			]
		},
		{
			"key": "highlightText",
			"label": "Highlighted words colour",
			"panel": "Heading",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-h2 h2 em",
					"prop": "color"
				}
			]
		},
		{
			"key": "columns",
			"label": "Text / form widths",
			"panel": "Layout",
			"control": "select",
			"options": [
				{
					"label": "Text 1/3, form 2/3",
					"value": "minmax(0, 1fr) minmax(0, 2fr)"
				},
				{
					"label": "Text 2/5, form 3/5",
					"value": "minmax(0, 2fr) minmax(0, 3fr)"
				},
				{
					"label": "Half and half",
					"value": "minmax(0, 1fr) minmax(0, 1fr)"
				},
				{
					"label": "Text 3/5, form 2/5",
					"value": "minmax(0, 3fr) minmax(0, 2fr)"
				}
			],
			"rules": [
				{
					"sel": " .bwex-wfu-form__grid",
					"prop": "grid-template-columns",
					"media": "desktop"
				}
			]
		},
		{
			"key": "gap",
			"label": "Space between text and form",
			"panel": "Layout",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-wfu-form__grid",
					"prop": "gap"
				}
			]
		},
		{
			"key": "formFirst",
			"label": "Form on the left (wide screens)",
			"panel": "Layout",
			"control": "toggle",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "order",
					"valueMap": {
						"true": "-1"
					},
					"media": "desktop"
				}
			]
		},
		{
			"key": "stickyText",
			"label": "Text stays in view while scrolling (wide screens)",
			"panel": "Layout",
			"control": "toggle",
			"rules": [
				{
					"sel": " .bwex-wfu-form__aside",
					"prop": "position",
					"valueMap": {
						"true": "sticky"
					},
					"media": "desktop"
				}
			]
		},
		{
			"key": "introColor",
			"label": "Colour",
			"panel": "Intro",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-intro p",
					"prop": "color"
				}
			]
		},
		{
			"key": "introSize",
			"label": "Size",
			"panel": "Intro",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwex-intro p",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "introLink",
			"label": "Link colour",
			"panel": "Intro",
			"control": "color",
			"rules": [
				{
					"sel": " .bwex-wfu-form__aside a",
					"prop": "color"
				}
			]
		},
		{
			"key": "cardBg",
			"label": "Background",
			"panel": "Form card",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "cardBorder",
			"label": "Border colour",
			"panel": "Form card",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "cardBorderWidth",
			"label": "Border width",
			"panel": "Form card",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "border-width"
				},
				{
					"sel": " .bwe-form-card",
					"prop": "border-style",
					"fixed": "solid"
				}
			]
		},
		{
			"key": "cardRadius",
			"label": "Corner radius",
			"panel": "Form card",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "border-radius"
				}
			]
		},
		{
			"key": "cardPadding",
			"label": "Inner space",
			"panel": "Form card",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "padding"
				}
			]
		},
		{
			"key": "cardShadow",
			"label": "Shadow",
			"panel": "Form card",
			"control": "select",
			"options": [
				{
					"label": "None",
					"value": "none"
				},
				{
					"label": "Soft",
					"value": "soft"
				},
				{
					"label": "Strong",
					"value": "strong"
				}
			],
			"rules": [
				{
					"sel": " .bwe-form-card",
					"prop": "box-shadow",
					"valueMap": {
						"none": "none",
						"soft": "0 18px 40px -28px rgba(17, 17, 17, .35)",
						"strong": "0 28px 60px -24px rgba(17, 17, 17, .55)"
					}
				}
			]
		},
		{
			"key": "labelColor",
			"label": "Label colour",
			"panel": "Fields",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 label",
					"prop": "color"
				},
				{
					"sel": " .bwe-cf7__choices legend",
					"prop": "color"
				}
			]
		},
		{
			"key": "labelSize",
			"label": "Label size",
			"panel": "Fields",
			"control": "unit",
			"rules": [
				{
					"sel": " .bwe-cf7 label",
					"prop": "font-size"
				},
				{
					"sel": " .bwe-cf7__choices legend",
					"prop": "font-size"
				}
			]
		},
		{
			"key": "fieldBg",
			"label": "Field background",
			"panel": "Fields",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-form-control:is(.wpcf7-text, .wpcf7-email, .wpcf7-tel, .wpcf7-url, .wpcf7-select, .wpcf7-textarea)",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "fieldBorder",
			"label": "Field border",
			"panel": "Fields",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-form-control:is(.wpcf7-text, .wpcf7-email, .wpcf7-tel, .wpcf7-url, .wpcf7-select, .wpcf7-textarea)",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "fieldText",
			"label": "Field text",
			"panel": "Fields",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-form-control:is(.wpcf7-text, .wpcf7-email, .wpcf7-tel, .wpcf7-url, .wpcf7-select, .wpcf7-textarea)",
					"prop": "color"
				}
			]
		},
		{
			"key": "fieldPlaceholder",
			"label": "Placeholder text",
			"panel": "Fields",
			"control": "color",
			"rules": [
				{
					"sel": " .bwe-cf7 .wpcf7-form-control::placeholder",
