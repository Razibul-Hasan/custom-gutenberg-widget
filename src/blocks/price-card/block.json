{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "bwe/price-card",
	"title": "Price card",
	"category": "bestwebexpert",
	"icon": "tag",
	"description": "One price card: chip, linked title, text, price rows, \"from\" price and button. Its own colours can differ from the other cards (Styles tab).",
	"keywords": [
		"price",
		"pricing",
		"card",
		"services",
		"best web expert",
		"bwe"
	],
	"parent": [
		"bwe/price-section"
	],
	"textdomain": "bestwebexpert",
	"attributes": {
		"wrapClasses": {
			"type": "string",
			"default": "elementor-element elementor-widget elementor-widget-bwex-platform-card"
		},
		"cardId": {
			"type": "string",
			"default": ""
		},
		"chip": {
			"type": "string",
			"default": ""
		},
		"title": {
			"type": "string",
			"default": ""
		},
		"titleUrl": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": ""
		},
		"price": {
			"type": "string",
			"default": ""
		},
		"btnText": {
			"type": "string",
			"default": ""
		},
		"btnUrl": {
			"type": "string",
			"default": ""
		},
		"btnNewTab": {
			"type": "boolean",
			"default": false
		},
		"bweStyle": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"reusable": false
	},
	"editorScript": "bwe-gw-editor",
	"render": "file:./render.php",
	"bweStyleMap": [
		{
			"key": "bg",
			"label": "Card background",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc)",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "border",
			"label": "Card border",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc)",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "chipBg",
			"label": "Tag background",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__chip",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "chipColor",
			"label": "Tag text",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__chip",
					"prop": "color"
				}
			]
		},
		{
			"key": "chipDot",
			"label": "Tag dot",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__chip::before",
					"prop": "background-color"
				}
			]
		},
		{
			"key": "titleColor",
			"label": "Title",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-h3 .elementor-heading-title",
					"prop": "color"
				},
				{
					"sel": ":not(#bwe-pc) .bwex-h3 .elementor-heading-title a",
					"prop": "color"
				}
			]
		},
		{
			"key": "textColor",
			"label": "Text",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__text p",
					"prop": "color"
				}
			]
		},
		{
			"key": "rowService",
			"label": "Price rows: service",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwe-prx__svc",
					"prop": "color"
				}
			]
		},
		{
			"key": "rowNote",
			"label": "Price rows: turnaround",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwe-prx__svc small",
					"prop": "color"
				}
			]
		},
		{
			"key": "rowAmount",
			"label": "Price rows: price",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwe-prx__amt",
					"prop": "color"
				}
			]
		},
		{
			"key": "rowLines",
			"label": "Price rows: lines",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwe-prx__list",
					"prop": "border-top-color"
				},
				{
					"sel": ":not(#bwe-pc) .bwe-prx__list li",
					"prop": "border-bottom-color"
				}
			]
		},
		{
			"key": "fromColor",
			"label": "\"From\" price",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__price",
					"prop": "color"
				}
			]
		},
		{
			"key": "fromAmount",
			"label": "\"From\" amount",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-plat__price strong",
					"prop": "color"
				}
			]
		},
		{
			"key": "btnBg",
			"label": "Button background",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-btn .elementor-button",
					"prop": "background-color"
				},
				{
					"sel": ":not(#bwe-pc) .bwex-btn .elementor-button",
					"prop": "border-color"
				}
			]
		},
		{
			"key": "btnText",
			"label": "Button text",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-btn .elementor-button",
					"prop": "color"
				}
			]
		},
		{
			"key": "btnHoverBg",
			"label": "Button on hover",
			"panel": "This card",
			"control": "color",
			"rules": [
				{
					"sel": ":not(#bwe-pc) .bwex-btn .elementor-button:hover",
					"prop": "background-color"
				},
				{
					"sel": ":not(#bwe-pc) .bwex-btn .elementor-button:hover",
					"prop": "border-color"
				}
			]
		}
	]
}
